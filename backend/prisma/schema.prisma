generator client {
  provider = "prisma-client-js"
  output   = "../../node_modules/.prisma/client"
}

datasource db {
  provider = "sqlite"
  url      = "file:./dev.db"
}

// ─── MODELS ───────────────────────────────────────────

model User {
  id                 Int      @id @default(autoincrement())
  email              String   @unique
  password           String
  name               String
  role               String   // RUMAH_TANGGA, DRIVER, ADMIN_TPS3R, CUSTOMER, PEMDA, SUPER_ADMIN
  phone              String?
  verificationStatus String   @default("ACTIVE") // ACTIVE, PENDING, REJECTED
  points             Int      @default(0)
  createdAt          DateTime @default(now())
  updatedAt          DateTime @default(now())

  // Legacy fields (keep for backward compat)
  address            String?
  zone               String?

  // Role RUMAH_TANGGA
  houseRole          String?  // KEPALA_KELUARGA, PASANGAN, ANAK, LAINNYA
  postalCode         String?

  // Role DRIVER
  driverType         String?  // FREELANCE, MITRA_TPS3R
  domicile           String?
  vehicleType        String?   // Jenis kendaraan, contoh: "Motor", "Pickup Bak"
  vehiclePlate       String?   // Plat nomor kendaraan
  isOnDuty           Boolean   @default(false)  // apakah sedang aktif bertugas

  // Role ADMIN_TPS3R
  tpsName            String?
  tpsAddress         String?

  // Role CUSTOMER
  industryType       String?  // INDUSTRI, PENGRAJIN, PELAJAR
  companyAddress     String?
  companyPostalCode  String?

  // Role PEMDA
  region             String?
  officeAddress      String?

  // Relations
  pickupRequestsAsUser   PickupRequest[]     @relation("UserPickups")
  pickupRequestsAsDriver PickupRequest[]     @relation("DriverPickups")
  inventories            Inventory[]
  transactions           Transaction[]
  voucherRedemptions     VoucherRedemption[]
  expeditionsAsDriver    Expedition[]        @relation("ExpeditionDriver")
  verificationQueue      VerificationQueue?
  ordersAsCustomer       Order[]             @relation("CustomerOrders")
  ordersAsTps3r          Order[]             @relation("Tps3rOrders")
  ordersAsDriver         Order[]             @relation("DriverOrders")
}

model WasteCategory {
  id            Int      @id @default(autoincrement())
  name          String   @unique
  slug          String   @unique
  imageUrl      String
  priceEstMin   Int
  priceEstMax   Int
  description   String
  sortingTips   String
  isActive      Boolean  @default(true)
  sortOrder     Int      @default(0)
  createdAt     DateTime @default(now())

  pickupItems    PickupItem[]
  inventoryItems Inventory[]
}

model PickupRequest {
  id              Int      @id @default(autoincrement())
  userId          Int
  driverId        Int?
  status          String   @default("PENDING") // PENDING, ON_THE_WAY, COLLECTED, VERIFIED, COMPLETED, CANCELLED
  address         String
  note            String?
  estimatedWeight String   // "Ringan"|"Sedang"|"Berat"
  actualWeight    Float?
  points          Int?
  environmentalImpact String? // JSON string
  createdAt       DateTime @default(now())
  updatedAt       DateTime @default(now())
  acceptedAt      DateTime?
  collectedAt     DateTime?
  deliveredAt     DateTime?
  tps3rTargetId   Int?       // FK ke User (role ADMIN_TPS3R) yang dituju driver
  cancelReason    String?    // alasan jika dibatalkan driver

  // Legacy field for backward compat with old data
  wasteTypes      String?

  user         User          @relation("UserPickups", fields: [userId], references: [id])
  driver       User?         @relation("DriverPickups", fields: [driverId], references: [id])
  items        PickupItem[]
  transactions Transaction[]
}

model PickupItem {
  id              Int    @id @default(autoincrement())
  pickupRequestId Int
  wasteCategoryId Int
  estimatedQty    String?

  pickupRequest PickupRequest @relation(fields: [pickupRequestId], references: [id])
  wasteCategory WasteCategory @relation(fields: [wasteCategoryId], references: [id])
}

model Inventory {
  id              Int      @id @default(autoincrement())
  tps3rId         Int
  wasteCategoryId Int?
  commodity       String
  stockKg         Float
  pricePerKg      Float
  status          String   @default("READY") // READY, PROCESSING, SOLD_OUT
  isPublic        Boolean  @default(true)
  description     String?
  createdAt       DateTime @default(now())
  updatedAt       DateTime @default(now())

  tps3r           User           @relation(fields: [tps3rId], references: [id])
  wasteCategory   WasteCategory? @relation(fields: [wasteCategoryId], references: [id])
  expeditionItems ExpeditionItem[]
  orders          Order[]        @relation("InventoryOrders")
}

model Expedition {
  id                 Int      @id @default(autoincrement())
  driverId           Int
  type               String   // TPS3R_TO_TPS3R, TPS3R_TO_MITRA
  status             String   @default("ASSIGNED") // ASSIGNED, ON_THE_WAY, ARRIVED, CONFIRMED, CANCELLED
  originId           Int
  destinationId      Int
  originName         String
  destinationName    String
  originAddress      String
  destinationAddress String
  manifest           String?  // JSON string
  waybillNumber      String?
  notes              String?
  assignedAt         DateTime @default(now())
  departedAt         DateTime?
  arrivedAt          DateTime?
  confirmedAt        DateTime?
  updatedAt          DateTime @default(now())

  driver User            @relation("ExpeditionDriver", fields: [driverId], references: [id])
  items  ExpeditionItem[]
}

model ExpeditionItem {
  id           Int    @id @default(autoincrement())
  expeditionId Int
  inventoryId  Int
  weightKg     Float
  notes        String?

  expedition Expedition @relation(fields: [expeditionId], references: [id])
  inventory  Inventory  @relation(fields: [inventoryId], references: [id])
}

model VerificationQueue {
  id          Int      @id @default(autoincrement())
  userId      Int      @unique
  role        String
  submittedAt DateTime @default(now())
  reviewedBy  String?
  reviewedAt  DateTime?
  status      String   @default("PENDING") // ACTIVE, PENDING, REJECTED
  notes       String?

  user User @relation(fields: [userId], references: [id])
}

model Transaction {
  id          Int      @id @default(autoincrement())
  userId      Int
  pickupId    Int?
  points      Int
  type        String   // EARNED, REDEEMED, EARN, REDEEM, DEDUCTION
  description String
  createdAt   DateTime @default(now())

  user   User           @relation(fields: [userId], references: [id])
  pickup PickupRequest? @relation(fields: [pickupId], references: [id])
}

model VoucherRedemption {
  id          Int      @id @default(autoincrement())
  userId      Int
  voucherName String
  pointsUsed  Int
  createdAt   DateTime @default(now())

  user User @relation(fields: [userId], references: [id])
}

model Order {
  id                 Int      @id @default(autoincrement())
  customerId         Int
  tps3rId            Int
  driverId           Int?
  inventoryId        Int
  quantityKg         Float
  pricePerKgSnapshot Float
  totalPrice         Float
  status             String   @default("PENDING") // PENDING, CONFIRMED, DRIVER_ASSIGNED, ON_THE_WAY, DELIVERED, COMPLETED, REJECTED
  deliveryAddress    String
  notes              String?
  rejectionReason    String?
  createdAt          DateTime @default(now())
  updatedAt          DateTime @default(now())

  customer  User      @relation("CustomerOrders", fields: [customerId], references: [id])
  tps3r     User      @relation("Tps3rOrders", fields: [tps3rId], references: [id])
  driver    User?     @relation("DriverOrders", fields: [driverId], references: [id])
  inventory Inventory @relation("InventoryOrders", fields: [inventoryId], references: [id])
}
